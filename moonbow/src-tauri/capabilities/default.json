{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC plus HTTP to the hosts the app actually talks to.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://music.youtube.com/*" },
        { "url": "https://www.youtube.com/*" },
        { "url": "https://youtube.com/*" },
        { "url": "https://*.youtube.com/*" },
        { "url": "https://youtubei.googleapis.com/*" },
        { "url": "https://*.googleusercontent.com/*" },
        { "url": "https://*.ggpht.com/*" },
        { "url": "https://i.ytimg.com/*" },
        { "url": "https://*.ytimg.com/*" },
        { "url": "https://lrclib.net/*" }
      ]
    }
  ]
}
