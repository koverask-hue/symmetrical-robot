{
  "name": "breakpoint",
  "version": "1.0.0",
  "description": "Fully destructible voxel heist game for macOS.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "app": "electron .",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "selftest": "node scripts/selftest.js",
    "icon": "node scripts/make-icon.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "main": "electron/main.cjs",
  "productName": "Breakpoint",
  "author": "Breakpoint",
  "build": {
    "appId": "dev.breakpoint.game",
    "productName": "Breakpoint",
    "copyright": "Breakpoint",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "style.css",
      "src/**/*",
      "vendor/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.action-games",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Breakpoint ${version}",
      "artifactName": "Breakpoint-${version}-${arch}.dmg"
    }
  }
}
